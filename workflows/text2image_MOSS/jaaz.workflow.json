      "required": true,
      "node_id": "18:17",
      "node_input_name": "value",
      "default_value": "",
      "description": "必填。详细描述画面主体、光影与版式，需渲染的文字请用双引号括起。"
    },
    {
      "name": "aspect_ratio",
