      "type": "string",
      "required": true,
      "node_id": "18:17",
      "node_input_name": "value",
      "default_value": "",
      "description": "必填。目标新画面的主体、动作、场景或风格迁移描述。"
    },
    {
      "name": "reference_image_2",
      "type": "image",
      "required": false,
      "node_id": "29",
      "node_input_name": "image",
      "default_value": "",
      "description": "可选。第 2 张参考图文件名；不用请留空。"
    },
    {
      "name": "reference_image_3",
      "type": "image",
      "required": false,
      "node_id": "30",
      "node_input_name": "image",
      "default_value": "",
      "description": "可选。第 3 张参考图文件名；不用请留空。"
